#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/santak-nut-bridge

start_service() {
	config_load santak-nut-bridge
	config_get serial main serial /dev/ttyACM0
	config_get listen main listen 0.0.0.0:3493
	config_get name main name ups
	config_get user main user monuser
	config_get password main password secret
	config_get manufacturer main manufacturer SANTAK
	config_get model main model 'Megatec/Q1 UPS'
	config_get poll main poll 5s
	config_get stale_after main stale_after 30s
	config_get battery_low main battery_low 1.75
	config_get battery_high main battery_high 2.30

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		UPS_SERIAL="$serial" \
		UPS_LISTEN="$listen" \
		UPS_NAME="$name" \
		UPS_USER="$user" \
		UPS_PASSWORD="$password" \
		UPS_MANUFACTURER="$manufacturer" \
		UPS_MODEL="$model" \
		UPS_POLL="$poll" \
		UPS_STALE_AFTER="$stale_after" \
		UPS_BATTERY_LOW="$battery_low" \
		UPS_BATTERY_HIGH="$battery_high"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger santak-nut-bridge
}

config main 'main'
	option serial '/dev/ttyACM0'
	option listen '0.0.0.0:3493'
	option name 'ups'
	option user 'monuser'
	option password 'secret'
	option manufacturer 'SANTAK'
	option model 'Megatec/Q1 UPS'
	option poll '5s'
	option stale_after '30s'
	option battery_low '1.75'
	option battery_high '2.30'
